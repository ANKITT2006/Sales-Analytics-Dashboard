# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Local Database URL (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Razorpay Payment Gateway Credentials (Test or Live)
# Obtain these from your Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Razorpay Webhook Secret
# Configured in Razorpay Dashboard -> Webhooks -> Add New Webhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Supabase Configuration (PostgreSQL Database & Row Level Security)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# CRITICAL: Keep service-role key strictly confidential on the server. Never expose to client/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

